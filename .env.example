# Copy this file to .env.local and fill in the two values from your Supabase
# project (dashboard → Connect, or Project Settings → API).
# Leave them empty to run with made-up sample data instead.
#
# Only the Project URL and the anon / publishable key go here.
# NEVER put the service_role / secret key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
